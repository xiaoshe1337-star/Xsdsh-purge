{
  "name": "dsh-purge",
  "version": "3.0.0",
  "description": "dsh-purge 逆向模式：跨平台逆向分析指挥体系（iOS / Android / Windows），五角色 + 五阶段 + 证据链",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json",
    "./locator": "./tools/deepseek-harness-locator.mjs",
    "./reverse": "./lib/reverse/index.js",
    "./reverse/store": "./lib/reverse/store.js",
    "./reverse/ui": "./lib/reverse/ui.js",
    "./reverse/tools": "./lib/reverse/tools.js"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js",
    "dsh-locate-harness": "tools/deepseek-harness-locator.mjs",
    "dsh-locate-harness-cmd": "tools/find-deepseek-harness.cmd"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "tools"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuJunZhiXue/dsh-purge.git"
  },
  "homepage": "https://github.com/YuJunZhiXue/dsh-purge#readme",
  "bugs": {
    "url": "https://github.com/YuJunZhiXue/dsh-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/YuJunZhiXue/dsh-purge/archive/refs/heads/master.tar.gz",
      "zip": "https://github.com/YuJunZhiXue/dsh-purge/archive/refs/heads/master.zip",
      "git": "https://github.com/YuJunZhiXue/dsh-purge.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18",
    "dsh": "0.2.1-rc.2"
  },
  "dshTarget": "0.2.1-rc.2"
}